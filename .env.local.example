# ═════════════════════════════════════════════════════════════════
# SAGECO EVERGREEN — Environment Variables
# ═════════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in your values.
# Also set these in Vercel: Settings → Environment Variables.

# ── Supabase ──────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://emldbjqegftrngxypeca.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_URL=https://emldbjqegftrngxypeca.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Site URL ──────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://sageco-evergreen-co.vercel.app

# ── Admin ─────────────────────────────────────────────────────────
# Admin secret for API route protection (used in x-admin-secret header)
ADMIN_SECRET=your_admin_secret_here
# NOTE: Do NOT use NEXT_PUBLIC_ADMIN_SECRET — it exposes the secret to the browser.
# Client-side admin pages use sessionStorage to store the admin secret.

# ── PesaPal Payments ──────────────────────────────────────────────
# Get these from: PesaPal Dashboard
PESAPAL_CONSUMER_KEY=your_pesapal_key
PESAPAL_CONSUMER_SECRET=your_pesapal_secret
PESAPAL_ENV=sandbox  # or 'production' when going live
PESAPAL_IPN_ID=your_ipn_id

# ── Email (Resend) ────────────────────────────────────────────────
# Get this from: https://resend.com
RESEND_API_KEY=your_resend_api_key
