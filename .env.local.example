# SageCo Evergreen — Environment Variables
# Copy to .env.local for development

# Supabase (hardcoded in API routes for production — these are for local dev overrides)
NEXT_PUBLIC_SUPABASE_URL=https://eiyexnuhqdscomilwpqg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# PesaPal
PESAPAL_CONSUMER_KEY=your_pesapal_consumer_key
PESAPAL_CONSUMER_SECRET=your_pesapal_consumer_secret
PESAPAL_ENV=sandbox
PESAPAL_IPN_ID=your_ipn_id

# Site
NEXT_PUBLIC_SITE_URL=https://sageco-evergreen-co.vercel.app

# Admin
ADMIN_SECRET=your_admin_secret
